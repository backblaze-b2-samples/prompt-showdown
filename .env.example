# Backblaze B2 (required) — S3-compatible API
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
B2_REGION=your_b2_region
# Optional: friendly public URL base for public buckets. Leave blank for
# private buckets (the app uses presigned URLs instead).
B2_PUBLIC_URL_BASE=

# NVIDIA NIM (required for showdown runs) — get a free key at build.nvidia.com.
# Free tier is rate-limited (~40 req/min), no per-token billing.
NVIDIA_API_KEY=your_nvidia_api_key
# Optional model overrides (defaults shown):
# SHOWDOWN_GEN_MODEL=meta/llama-3.3-70b-instruct
# SHOWDOWN_JUDGE_MODEL=meta/llama-3.3-70b-instruct

# Example of what filled-in B2 values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=00abcdef1234567000000001
# B2_APPLICATION_KEY=K001AbCdEfGhIjKlMnOpQrStUvWxYz0=
# B2_BUCKET_NAME=my-showdown-runs
# B2_REGION=us-west-004
